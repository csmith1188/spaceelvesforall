<script>
  // Get canvas and context
  var canvas = document.getElementById('game-canvas');
  var ctx = canvas.getContext('2d');

  var game = new Game({
    client: true
  });

  function applyCanvasResize() {
    const windowW = window.innerWidth;
    const windowH = window.innerHeight;
    const renderW = Math.min(windowW, 1920);
    const renderH = Math.min(windowH, 1080);
    if (canvas.width !== renderW || canvas.height !== renderH) {
      canvas.width = renderW;
      canvas.height = renderH;
    }
    canvas.style.width = `${renderW}px`;
    canvas.style.height = `${renderH}px`;
    game.browserWindow.w = windowW;
    game.browserWindow.h = windowH;
    game.renderOffset.x = Math.max(0, (windowW - renderW) / 2);
    game.renderOffset.y = Math.max(0, (windowH - renderH) / 2);
    game.window.w = renderW;
    game.window.h = renderH;
    game.gameView.w = renderW;
    game.gameView.h = renderH;
    if (game.player) {
      game.player.camera.radius = Math.sqrt((renderW / 2) ** 2 + (renderH / 2) ** 2);
    }
  }

  applyCanvasResize();
  window.addEventListener('resize', applyCanvasResize);

  let accumulator = 0;
  let lastFrameTime = performance.now();
  const fixedStepMs = game.time.tickRate;
  const maxCatchupSteps = 5;

  function gameLoop(now) {
    const elapsedMs = now - lastFrameTime;
    lastFrameTime = now;
    accumulator += elapsedMs;

    let steps = 0;
    while (accumulator >= fixedStepMs && steps < maxCatchupSteps) {
      game.step();
      accumulator -= fixedStepMs;
      steps++;
    }

    if (steps === maxCatchupSteps) {
      accumulator = 0;
    }

    requestAnimationFrame(gameLoop);
  }

  requestAnimationFrame(gameLoop);

  // networkStats.enabled = true; syncDebug.enabled = true;
</script>

</html>