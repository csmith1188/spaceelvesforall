<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://csmith1188.github.io/">
  <meta property="og:title" content="Space Elves on Jetbikes">
  <meta property="og:description" content="For Speed. For Honor. Forever.">
  <meta property="og:image" content="img/sprites/jetbike.png">
  <!-- <meta name="viewport" content="width=device-width, initial-scale=1.0"> -->
  <title>Space Elves on Jetbikes</title>
  <link rel="apple-touch-icon" sizes="180x180" href="img/icons//apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="img/icons//favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="img/icons/favicon-32x32.png">
  <link rel="stylesheet" href="styles/game.css">


</head>

<body>
  <div id="game-stage">
    <div id="game-stage-inner">
      <div id="ground-layer">
        <div id="ground-world"></div>
      </div>
      <canvas width=1280 height=720 id="game-canvas">Your browser needs to be able to render an HTML5 Canvas</canvas>
      <canvas width=1280 height=720 id="hud-canvas"></canvas>
    </div>
  </div>
  <div id="debugger">
    Enable Debug
    <input type="checkbox" onchange="game.debug = this.checked;">
    <br>
    Enable 3D
    <input type="checkbox" onchange="game.player.camera._3D = this.checked;">
    <input type="range" value="1" min="0" max="1" step="0.01" oninput="game.player.camera.angle = this.value;">
    <br>
    Network Debug
    <input type="checkbox" onchange="if(this.checked) networkStats.start(); else networkStats.stop();">
    <br>
    Sync Debug
    <input type="checkbox" onchange="if(this.checked) syncDebug.start(); else syncDebug.stop();">
  </div>
</body>

<script>
  var token = <%- JSON.stringify(token) %>;
  var PORT = <%- JSON.stringify(PORT) %>;
  var THIS_URL = <%- JSON.stringify(THIS_URL) %>;
  var MASTER_PORT = <%- JSON.stringify(MASTER_PORT) %>;
  var masterUrl = <%- JSON.stringify(masterUrl) %>;
  var GAME_WS_PATH = <%- JSON.stringify(typeof gameWsPath !== 'undefined' ? gameWsPath : null) %>;
  var client = true;
</script>

<script src="engine/utils.js"></script>
<script src="engine/sound.js"></script>
<script src="engine/network_debug.js"></script>
<script src="engine/sync_debug.js"></script>
<script src="engine/game/match/block/block.js"></script>
<script src="engine/game/match/block/projectile.js"></script>
<script src="engine/game/match/item.js"></script>
<script src="engine/game/match/block/powerup.js"></script>
<script src="engine/game/player/interface.js"></script>
<script src="engine/game/player/menus.js"></script>
<script src="engine/game/match/character.js"></script>
<script src="engine/game/match/map/map.js"></script>
<script src="engine/game/match/match.js"></script>
<script src="engine/game/player/controller.js"></script>
<script src="engine/game/player/camera.js"></script>
<script src="engine/game/player/player.js"></script>
<script src="engine/game/player/bot_ai.js"></script>
<script src="engine/game/match/match_forhonormp.js"></script>
<script src="engine/game/match/for_ever.js"></script>
<script src="engine/socket_client.js"></script>
<script src="engine/game/game.js"></script>
<script src="engine/game/client_boot.js"></script>

</html>