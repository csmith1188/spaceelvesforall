<h2>Games</h2>
<div id="gameList">
  <div class="headerRow">
    <div class="colCell colCellDouble">Server Name</div>
    <div class="colCell">Status</div>
    <div class="colCell">Players</div>
  </div>
  <div class="listRow">
    <div class="colCell colCellDouble"><a href="/newgame">Start a new Game</a></div>
    <div class="colCell">---</div>
    <div class="colCell">---</div>
  </div>
  <% if (gamesList.length > 0) { %>
  <% gamesList.forEach(game => { %>
  <div class="listRow">
    <%# <div style="flex: 1;">game.serverName</div> #%>
    <%# <div style="flex: 1;">game.players</div> #%>
    <%# <div style="flex: 1;">game.status</div> #%>
    <div class="colCell colCellDouble"><a href="http://192.168.1.103:<%- game %>/">Game <%- game %></a></div>
    <div class="colCell">Probably Online</div>
    <div class="colCell">Probably None</div>
  </div>
  <% }); %>
  <% } %>
</div>