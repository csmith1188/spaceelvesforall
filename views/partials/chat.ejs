<div id="chatBox">
    <div id="roomList" class="tabs">
    </div>
    <div id="chatContainer">
        <div id="userList">
        </div>
        <div id="chatMessages">
            <div id="chatMessagesContent">
            </div>
            <div id="chatInput">
                <input type="text" id="chatInputField" placeholder="Type a message...">
                <button id="chatSendButton" onclick="sendMessage()">Send</button>
            </div>
        </div>
    </div>
</div>

<script>
    
    const chatMessagesContent = document.getElementById('chatMessagesContent');
    const chatInputField = document.getElementById('chatInputField');
    const chatSendButton = document.getElementById('chatSendButton');
    const userList = document.getElementById('userList');
    const roomList = document.getElementById('roomList');

    const ws = new WebSocket('ws://localhost:3000/chat');
    
    ws.onopen = () => {
        console.log('Connected to the chat server');
    };

    ws.onmessage = (message) => {
        const data = JSON.parse(message.data);
        if (data.message) {
                let message = document.createElement('div');
                message.classList.add('message');
                message.innerHTML = `<b>[${data.room}] ${data.sender}: </b>${data.message}`;
                chatMessagesContent.appendChild(message);
                //scroll to bottom of chat
                chatMessagesContent.scrollTop = chatMessagesContent.scrollHeight;
        }
        if (data.userList) {
            userList.innerHTML = '';
            data.userList.forEach(user => {
                let userItem = document.createElement('div');
                let userLink = document.createElement('a');
                userLink.href = '#';
                userLink.innerText = user;
                userItem.appendChild(userLink);
                userList.appendChild(userItem);
            });
        }
        if (data.rooms) {
            roomList.innerHTML = '';
            data.rooms.forEach(room => {
                let roomItem = document.createElement('div');
                roomItem.classList.add('tab');
                let roomLink = document.createElement('a');
                roomLink.href = '#';
                roomLink.innerText = room;
                roomItem.appendChild(roomLink);
                roomItem.addEventListener('click', () => {
                    ws.send(JSON.stringify({ message: "/" + room }));
                });
                roomList.appendChild(roomItem);
            });
        }
        if (data.currentRoom) {
            // Change the placeholder text of the chat input field to the current room
            chatInputField.placeholder = `Message #${data.currentRoom}...`;
        }
    };

    function sendMessage() {
        const message = chatInputField.value;
        if (!message) {
            return;
        }
        ws.send(JSON.stringify({ message: message }));
        chatInputField.value = '';
    }

    chatInputField.addEventListener('keypress', (event) => {
        if (event.key === 'Enter') {
            sendMessage();
        }
    });

</script>