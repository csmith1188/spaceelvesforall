<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Custom match · Space Elves</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <p id="games-notice" class="notice<%= notice ? "" : " hidden" %>" role="status"><%= notice || "" %></p>

    <section>
      <h2>Custom match</h2>
      <p class="hint">Set the rules, then start the lobby and wait for an opponent.</p>

      <form class="lobby-create" id="lobby-create-form">
        <div class="lobby-create-fields">
          <label for="matchType">Match</label>
          <select id="matchType" name="matchType"></select>

          <label for="lobbyPassword">Password <span class="hint-inline">(optional)</span></label>
          <input id="lobbyPassword" name="lobbyPassword" type="password" maxlength="32" autocomplete="new-password" placeholder="Leave blank for open">

          <div class="play-split">
            <button type="submit">Start lobby</button>
            <a class="action" id="lobby-cancel" href="/games">Cancel</a>
          </div>
        </div>
      </form>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/games/create" }) %>
  <script type="module" src="/js/menus/lobby-create.js?v=<%= assetVersion %>"></script>
</body>
</html>
