<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title>IP activity · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <section>
      <h2>IP activity</h2>
      <p class="hint"><a href="/admin/security">Overview</a> · <a href="/admin/security/events">Events</a></p>

      <form class="admin-filter-form" method="get" action="/admin/security/ip">
        <label>IP address
          <input name="ip" value="<%= ipView.ip %>" required aria-label="IP address">
        </label>
        <div class="admin-filter-actions">
          <button type="submit">Look up</button>
        </div>
      </form>

      <% if (!ipView.ip) { %>
        <p class="hint">Enter an IP to view security events, login history, and throttle status. Temporary throttles expire automatically; there are no permanent IP bans.</p>
      <% } else { %>
        <div class="admin-panel">
          <h3><%= ipView.ip %></h3>
          <% if (ipView.throttle) { %>
            <p class="notice">Temporarily throttled until <%= new Date(ipView.throttle.until_ms).toLocaleString() %>
              (<%= ipView.throttle.reason || "abuse" %>, strikes <%= ipView.throttle.strikes %>)</p>
            <p class="hint">Rejected requests this window: <%= ipView.throttle.hit_count %>
              <% if (ipView.throttle.first_hit_at) { %>
                · first <%= new Date(ipView.throttle.first_hit_at).toLocaleString() %>
              <% } %>
              <% if (ipView.throttle.last_hit_at) { %>
                · last <%= new Date(ipView.throttle.last_hit_at).toLocaleString() %>
              <% } %>
              <% if (ipView.throttle.last_path) { %>
                · last path <span class="admin-mono"><%= ipView.throttle.last_path %></span>
              <% } %>
            </p>
            <% if (ipView.throttle.paths && ipView.throttle.paths.length) { %>
              <h4>Throttle window paths</h4>
              <table class="admin-table">
                <thead><tr><th>Path</th><th>Hits</th></tr></thead>
                <tbody>
                  <% ipView.throttle.paths.forEach(function (row) { %>
                    <tr>
                      <td class="admin-mono"><%= row.path %></td>
                      <td><%= row.n %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          <% } else { %>
            <p class="hint">No active temporary throttle.</p>
          <% } %>
        </div>

        <h3>Top paths (30d)</h3>
        <% if (!ipView.topPaths.length) { %>
          <p class="hint">No security events for this IP in the last 30 days.</p>
        <% } else { %>
          <table class="admin-table">
            <thead><tr><th>Path</th><th>Count</th></tr></thead>
            <tbody>
              <% ipView.topPaths.forEach(function (row) { %>
                <tr>
                  <td class="admin-mono"><%= row.path %></td>
                  <td><%= row.n %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>

        <h3>Security events</h3>
        <p class="admin-muted"><%= ipView.events.total %> events</p>
        <table class="admin-table">
          <thead>
            <tr><th>When</th><th>Class</th><th>Event</th><th>Path</th><th>Status</th></tr>
          </thead>
          <tbody>
            <% ipView.events.rows.forEach(function (row) { %>
              <tr>
                <td><%= new Date(row.created_at).toLocaleString() %></td>
                <td class="admin-mono"><%= row.class %></td>
                <td class="admin-mono"><%= row.event %></td>
                <td class="admin-mono"><%= row.path || "—" %></td>
                <td><%= row.status != null ? row.status : "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <h3>Login events</h3>
        <p class="admin-muted"><%= ipView.logins.total %> rows</p>
        <table class="admin-table">
          <thead>
            <tr><th>When</th><th>Account</th><th>Provider</th><th>OK</th><th>Platform</th></tr>
          </thead>
          <tbody>
            <% ipView.logins.rows.forEach(function (row) { %>
              <tr>
                <td><%= new Date(row.created_at).toLocaleString() %></td>
                <td><% if (row.account_id) { %><a href="/admin/users/<%= row.account_id %>"><%= row.account_id %></a><% } else { %>—<% } %></td>
                <td><%= row.provider || "—" %></td>
                <td><%= row.ok ? "yes" : "no" %></td>
                <td><%= row.platform || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </div>
</body>
</html>
