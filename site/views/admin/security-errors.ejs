<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title>Application errors · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <section>
      <h2>Application errors</h2>
      <p class="hint">
        Genuine app failures and session CSRF issues (<code>app_error</code>, <code>csrf_session</code>).
        Scanner noise is excluded.
        <a href="/admin/security">Overview</a>
      </p>

      <form class="admin-filter-form" method="get" action="/admin/security/errors">
        <table class="admin-table admin-filter-table">
          <thead><tr><th>IP</th><th>Path</th><th>Search</th></tr></thead>
          <tbody>
            <tr>
              <td><input name="ip" value="<%= filters.ip %>" aria-label="IP"></td>
              <td><input name="path" value="<%= filters.path %>" aria-label="Path"></td>
              <td><input name="q" value="<%= filters.q %>" aria-label="Search"></td>
            </tr>
          </tbody>
        </table>
        <div class="admin-filter-actions">
          <button type="submit">Filter</button>
          <a class="action" href="/admin/security/errors">Clear</a>
        </div>
      </form>

      <p class="admin-muted"><%= events.total %> events · page <%= events.page %></p>
      <table class="admin-table">
        <thead>
          <tr>
            <th>When</th>
            <th>Class</th>
            <th>Event</th>
            <th>IP</th>
            <th>Path</th>
            <th>Status</th>
            <th>Message</th>
          </tr>
        </thead>
        <tbody>
          <% events.rows.forEach(function (row) { %>
            <tr>
              <td><%= new Date(row.created_at).toLocaleString() %></td>
              <td class="admin-mono"><%= row.class %></td>
              <td class="admin-mono"><%= row.event %></td>
              <td class="admin-mono"><% if (row.ip) { %><a href="/admin/security/ip?ip=<%= encodeURIComponent(row.ip) %>"><%= row.ip %></a><% } else { %>—<% } %></td>
              <td class="admin-mono"><%= row.path || "—" %></td>
              <td><%= row.status != null ? row.status : "—" %></td>
              <td><%= row.message || "—" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </div>
</body>
</html>
