<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("../pwa-head") %>
  <title>Security events · Admin</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/css/admin.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("../header") %>
    <% if (notice) { %><p class="notice" role="status"><%= notice %></p><% } %>
    <%- include("_nav") %>
    <section>
      <h2>Security event explorer</h2>
      <p class="hint"><a href="/admin/security">Overview</a> · <a href="/admin/security/ip">IP activity</a> · <a href="/admin/security/errors">Errors</a></p>

      <form class="admin-filter-form" method="get" action="/admin/security/events">
        <table class="admin-table admin-filter-table">
          <thead>
            <tr>
              <th>Event</th>
              <th>Class</th>
              <th>IP</th>
              <th>Path</th>
              <th>Status</th>
              <th>Account</th>
              <th>Search</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><input name="event" value="<%= filters.event %>" aria-label="Event"></td>
              <td><input name="class" value="<%= filters.class %>" aria-label="Class"></td>
              <td><input name="ip" value="<%= filters.ip %>" aria-label="IP"></td>
              <td><input name="path" value="<%= filters.path %>" aria-label="Path"></td>
              <td><input name="status" value="<%= filters.status %>" aria-label="Status"></td>
              <td><input name="accountId" value="<%= filters.accountId %>" aria-label="Account"></td>
              <td><input name="q" value="<%= filters.q %>" aria-label="Search"></td>
            </tr>
          </tbody>
        </table>
        <div class="admin-filter-actions">
          <button type="submit">Filter</button>
          <a class="action" href="/admin/security/events">Clear</a>
        </div>
      </form>

      <p class="admin-muted"><%= events.total %> events · page <%= events.page %></p>
      <table class="admin-table">
        <thead>
          <tr>
            <th>When</th>
            <th>Class</th>
            <th>Event</th>
            <th>IP</th>
            <th>Method</th>
            <th>Path</th>
            <th>Status</th>
            <th>Account</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% events.rows.forEach(function (row) { %>
            <tr>
              <td><%= new Date(row.created_at).toLocaleString() %></td>
              <td class="admin-mono"><%= row.class %></td>
              <td class="admin-mono"><%= row.event %></td>
              <td class="admin-mono"><% if (row.ip) { %><a href="/admin/security/ip?ip=<%= encodeURIComponent(row.ip) %>"><%= row.ip %></a><% } else { %>—<% } %></td>
              <td><%= row.method || "—" %></td>
              <td class="admin-mono"><%= row.path || "—" %></td>
              <td><%= row.status != null ? row.status : "—" %></td>
              <td><% if (row.account_id) { %><a href="/admin/users/<%= row.account_id %>"><%= row.account_id %></a><% } else { %>—<% } %></td>
              <td><a class="action" href="/admin/security/events?id=<%= row.id %>&amp;event=<%= encodeURIComponent(filters.event) %>&amp;class=<%= encodeURIComponent(filters.class) %>&amp;ip=<%= encodeURIComponent(filters.ip) %>&amp;q=<%= encodeURIComponent(filters.q) %>">Detail</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% if (detail) { %>
        <div class="admin-panel">
          <h3>Event #<%= detail.id %></h3>
          <dl class="stats">
            <div><dt>When</dt><dd><%= new Date(detail.created_at).toLocaleString() %></dd></div>
            <div><dt>Class</dt><dd><%= detail.class %></dd></div>
            <div><dt>Severity</dt><dd><%= detail.severity || detail.level %></dd></div>
            <div><dt>Request</dt><dd class="admin-mono"><%= detail.request_id || "—" %></dd></div>
            <div><dt>UA</dt><dd><%= detail.user_agent || "—" %></dd></div>
            <div><dt>Message</dt><dd><%= detail.message || "—" %></dd></div>
          </dl>
          <% if (detail.meta) { %>
            <pre class="admin-mono" style="white-space: pre-wrap;"><%= JSON.stringify(detail.meta, null, 2) %></pre>
          <% } %>
        </div>
      <% } %>

      <% if (events.total > events.pageSize) { %>
        <p class="hint">
          <% if (events.page > 1) { %>
            <a href="/admin/security/events?page=<%= events.page - 1 %>&amp;event=<%= encodeURIComponent(filters.event) %>&amp;class=<%= encodeURIComponent(filters.class) %>&amp;ip=<%= encodeURIComponent(filters.ip) %>&amp;q=<%= encodeURIComponent(filters.q) %>">Prev</a>
          <% } %>
          <% if (events.page * events.pageSize < events.total) { %>
            <a href="/admin/security/events?page=<%= events.page + 1 %>&amp;event=<%= encodeURIComponent(filters.event) %>&amp;class=<%= encodeURIComponent(filters.class) %>&amp;ip=<%= encodeURIComponent(filters.ip) %>&amp;q=<%= encodeURIComponent(filters.q) %>">Next</a>
          <% } %>
        </p>
      <% } %>
    </section>
  </div>
</body>
</html>
