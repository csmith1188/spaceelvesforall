<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Match · Space Elves</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <section>
      <h2 id="lobby-title">Match</h2>
      <p id="lobby-status">Connecting…</p>
      <p id="lobby-opponent" class="hint"></p>
      <div class="play-split">
        <button type="button" id="site-start" hidden>Start</button>
        <button type="button" id="site-pause" hidden>Pause</button>
        <button type="button" id="site-concede">Leave</button>
        <button type="button" id="site-report" hidden>Report</button>
      </div>
      <form id="site-chat-form" hidden>
        <input id="site-chat-input" maxlength="200" placeholder="Chat" autocomplete="off">
      </form>
      <ul id="site-chat-log" class="list"></ul>
    </section>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/lobby.js?v=<%= assetVersion %>"></script>
</body>
</html>
