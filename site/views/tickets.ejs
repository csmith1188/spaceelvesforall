<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Buy tickets · Space Elves</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section class="ticket-store" id="ticket-store">
      <h2>Tickets</h2>
      <% if (!viewer) { %>
        <p class="hint">Log in to buy tickets.</p>
        <p><a class="action" href="/login">Log in</a></p>
      <% } else { %>
        <div class="ticket-balance" aria-label="Ticket balance">
          <p class="ticket-balance-label">Balance</p>
          <p class="ticket-balance-value" id="ticket-balance"><%= viewer.tickets %></p>
          <% if (viewer.held > 0) { %>
            <p class="hint ticket-balance-held">
              <%= Math.max(0, viewer.tickets - viewer.held) %> free
              · <%= viewer.held %> in use
            </p>
          <% } %>
        </div>
        <% if (!accountEmailVerified(viewer)) { %>
          <p class="hint">Verify your email to buy tickets.</p>
          <p><a class="action" href="/profile/<%= viewer.id %>">Open profile</a></p>
        <% } else if (canDigipog || canPaypal) { %>
          <p class="hint">Tickets are spent on ranked matches, custom lobbies, and extra suggestions.<% if (canDigipog && !canPaypal) { %> Formbar-linked accounts use Digipogs.<% } %></p>
          <% const packs = typeof buyPackages !== "undefined" && buyPackages ? buyPackages : []; %>
          <fieldset class="ticket-pack-fieldset">
            <legend class="ticket-pack-legend">Choose a pack</legend>
            <div class="ticket-pack-grid" role="radiogroup" aria-label="Ticket pack">
              <% packs.forEach(function (pack, index) { %>
                <label class="ticket-pack-option">
                  <input
                    type="radio"
                    name="packageId"
                    value="<%= pack.id %>"
                    <%= index === 0 ? "checked" : "" %>
                    <% if (canDigipog) { %>form="digipog-buy"<% } %>
                  >
                  <span class="ticket-pack-tickets"><%= pack.tickets %> tickets</span>
                  <span class="ticket-pack-price">
                    <% if (canPaypal) { %>
                      $<%= pack.amountValue %>
                    <% } else if (canDigipog) { %>
                      <%= pack.digipogs %> digipogs
                    <% } %>
                  </span>
                </label>
              <% }) %>
            </div>
          </fieldset>

          <div class="ticket-pay">
            <% if (canPaypal) { %>
              <%- include("paypal-store") %>
            <% } %>
            <% if (canDigipog) { %>
              <%- include("buy", { nextPath: "/buy" }) %>
            <% } %>
          </div>
        <% } else if (paypalEnabled) { %>
          <p class="hint">PayPal checkout is unavailable for this account.</p>
        <% } else { %>
          <p class="hint">Link a Formbar account to buy tickets with Digipogs, or enable PayPal checkout on this server.</p>
          <p><a class="action" href="/profile/<%= viewer.id %>">Open profile</a></p>
        <% } %>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/buy" }) %>
</body>
</html>
