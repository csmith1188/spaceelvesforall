<header class="top">
  <a class="brand" href="/">Space Elves</a>
  <% if (typeof accountNotices !== 'undefined' && accountNotices && accountNotices.length) { %>
    <div class="notice" role="status">
      <% accountNotices.forEach(function (n) { %>
        <p><%= n.text %>
          <form method="post" action="/notices/<%= n.id %>/read" style="display:inline">
            <%- include("csrf-field") %>
            <input type="hidden" name="next" value="/">
            <button type="submit" class="nav-link">Dismiss</button>
          </form>
        </p>
      <% }) %>
    </div>
  <% } %>
  <nav class="site-nav" aria-label="Site">
    <a href="/" class="<%= typeof nav !== 'undefined' && nav === 'home' ? 'active' : '' %>"> [ Home ]</a>
    <a href="/games" class="<%= typeof nav !== 'undefined' && nav === 'games' ? 'active' : '' %>"> [ Games ]</a>
    <a href="/scores" class="<%= typeof nav !== 'undefined' && nav === 'scores' ? 'active' : '' %>"> [ Ranks ]</a>
    <a href="/rules" class="<%= typeof nav !== 'undefined' && nav === 'rules' ? 'active' : '' %>"> [ Manual ]</a>
    <% if (viewer && accountEmailVerified(viewer)) { %>
      <button type="button" class="nav-link" id="suggest-open">[ Suggest ]</button>
    <% } %>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a href="/admin" class="<%= typeof nav !== 'undefined' && nav === 'admin' ? 'active' : '' %>"> [ Admin ]</a>
    <% } %>
    <% if (viewer) { %>
      <a href="/profile/<%= viewer.id %>">[ <%= viewer.name %> ]</a>
      <a href="/buy" class="<%= typeof nav !== 'undefined' && nav === 'buy' ? 'active' : '' %>"><%= viewer.tickets %> tickets<% if (viewer.held > 0) { %> (<%= viewer.held %> in use)<% } %></a>
      <a href="/logout"> [ Log out ]</a>
    <% } else if (typeof anyLoginEnabled === 'undefined' || anyLoginEnabled) { %>
      <a href="/login"> [ Log in ]</a>
    <% } %>
  </nav>
</header>
