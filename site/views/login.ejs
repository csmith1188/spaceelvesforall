<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Log in · Space Elves</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <% if (notice) { %>
      <p class="notice" role="status"><%= notice %></p>
    <% } %>

    <section>
      <h2>Log in</h2>
      <% if (disabled) { %>
        <p class="hint">Login is currently disabled.</p>
      <% } else { %>
        <% if (localAccountsEnabled) { %>
          <form method="post" action="/login">
<%- include("csrf-field") %>
            <% if (typeof nextPath !== "undefined" && nextPath) { %>
              <input type="hidden" name="next" value="<%= nextPath %>">
            <% } %>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="username" required value="<%= email || "" %>">
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
            <button type="submit" class="action">Log in</button>
          </form>
          <% if (authEmailEnabled) { %>
            <div class="auth-split">
              <a class="action" href="/signup">Create account</a>
              <a class="action" href="/forgot">Forgot password</a>
            </div>
          <% } else { %>
            <a class="action" href="/signup">Create account</a>
          <% } %>
          <% if (authEmailEnabled) { %>
            <form method="post" action="/verify/resend" class="auth-secondary">
<%- include("csrf-field") %>
              <label for="resend-email">Resend verification</label>
              <input id="resend-email" name="email" type="email" autocomplete="email" required value="<%= email || "" %>">
              <button type="submit">Resend</button>
            </form>
          <% } %>
        <% } %>
        <% if (formbarLoginEnabled) { %>
          <% if (localAccountsEnabled) { %><hr class="auth-break"><% } %>
          <a class="action" href="/login?formbar=1<%= typeof nextQuery !== 'undefined' ? nextQuery : '' %>">Log in with Formbar</a>
        <% } %>
        <% if (discordLoginEnabled) { %>
          <% if (localAccountsEnabled || formbarLoginEnabled) { %><hr class="auth-break"><% } %>
          <a class="action" href="/login?discord=1<%= typeof nextQuery !== 'undefined' ? nextQuery : '' %>">Log in with Discord</a>
        <% } %>
      <% } %>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/login" }) %>
</body>
</html>
