<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%- include("pwa-head") %>
  <title>Join via referral · Space Elves</title>
  <link rel="stylesheet" href="/css/landing.css?v=<%= assetVersion %>">
</head>
<body>
  <div class="page">
    <%- include("header") %>
    <section>
      <h2>You've been recruited</h2>
      <p><strong><%= referrerName %></strong> invited you to Space Elves.</p>
      <p><%= referralCopy %></p>
      <p class="hint">Referral code: <code><%= referralCode %></code></p>
      <p>
        <a class="action" href="/signup">Create account</a>
        <% if (typeof discordLoginEnabled !== 'undefined' && discordLoginEnabled) { %>
          <a class="action" href="/login?discord=1">Continue with Discord</a>
        <% } %>
      </p>
    </section>
  </div>
  <%- include("suggestion-modal", { nextPath: "/signup" }) %>
</body>
</html>
