PORT=3000
# Formbar server base URL (no /oauth suffix). A value ending in /oauth is also accepted and normalized.
AUTH_URL=http://localhost:420
# Public URL of this app (used in OAuth return + links). Example: http://localhost:3000 or https://your.domain
THIS_URL=http://localhost:3000
# Session signing — use SESSION_SECRET in production; SS_SECRET is still accepted as a fallback.
SESSION_SECRET=PutYourSuperSecretHere
# Optional: Formbar REST/socket API key for modules/formbarClient.js (socket.io to AUTH_URL)
# API_KEY=
# Optional: path segment for game URLs behind nginx (see README / deploy snippet). Example: gs
# GAME_PUBLIC_PREFIX=gs
